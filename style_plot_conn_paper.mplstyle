# AXES 
axes.labelcolor:    black
axes.facecolor:     white
axes.spines.right:  False
axes.spines.top:    False
axes.edgecolor:     black
axes.grid:          False
axes.axisbelow:     line 
axes.prop_cycle: cycler('color', ['darkgreen']) # default plot color is green

# LINES
lines.linewidth : 1 # was 1.9
lines.markersize: 3 # was 4.2

# FONTS
font.size :         8
font.family         : sans-serif
font.sans-serif     : Arial
axes.titlesize    : 8
axes.labelsize    : 8
xtick.labelsize   : 8
ytick.labelsize   : 8
legend.fontsize   : 8
figure.titlesize  : 8
svg.fonttype: none


# FIGURE
figure.autolayout: False # if false everything very tight. False for firing; True for intrinsic
# figure.subplot.hspace: 0.2
# figure.subplot.wspace: 0.2
savefig.facecolor: white
text.color: black

# TICKS
xtick.color: black
ytick.color: black

# BOXPLOT
boxplot.showfliers:  False
boxplot.showmeans:   False
boxplot.notch:       True
boxplot.patchartist: False
boxplot.boxprops.linewidth:     1.3
boxplot.boxprops.color:    430704
boxplot.capprops.linewidth:     1.3
boxplot.capprops.color:   430704
boxplot.whiskerprops.linewidth: 1.3
boxplot.whiskerprops.color:     430704
boxplot.medianprops.linewidth:    1.3
boxplot.medianprops.color:    430704

